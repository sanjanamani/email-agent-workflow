# ============================================================
# Inara AI Email Agent — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to git.
# ============================================================

# Google Maps Places API key
# Get it at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Snov.io API credentials (free tier)
# Get at: https://snov.io → Settings → API
SNOV_CLIENT_ID=your_snov_client_id_here
SNOV_CLIENT_SECRET=your_snov_client_secret_here

# Anthropic API key
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Gmail OAuth2 credentials (base64-encoded token.json)
# See README for one-time setup instructions
GMAIL_CREDENTIALS=base64_encoded_token_json_here

# Google Sheets spreadsheet ID
# From the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# ============================================================
# Optional overrides
# ============================================================

# Set to 'true' to run in dry-run mode (no emails sent, no sheet writes)
DRY_RUN=false

# Max emails to send per daily run (default: 20)
MAX_EMAILS_PER_DAY=20

# Delay in seconds between email sends (default: 30)
SEND_DELAY_SECONDS=30
