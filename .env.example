# Claude API — used to find practices via web search and validate emails
# Get it at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Serper — Google Search API for filling gaps in phone/website/address
# Get it at: https://serper.dev → Dashboard → API Key
# Optional: enrichment is skipped if this is absent
SERPER_API_KEY=your_serper_api_key_here

# Brevo — contacts are added to this account
# Get it at: https://app.brevo.com → Account → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Brevo contact list ID — practices with emails are added to this list
# Find it at: https://app.brevo.com → Contacts → Lists → click your list → ID is in the URL
BREVO_LIST_ID=7

# Brevo call list ID — practices WITHOUT a validated email go here (create this list in Brevo first)
BREVO_CALL_LIST_ID=

# Set to "true" to print all actions without writing to Brevo
DRY_RUN=false

# Maximum number of practices to process per run (default: 300)
MAX_PRACTICES=300
