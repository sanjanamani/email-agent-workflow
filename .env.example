# Google Maps Places API key
# Get it at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Brevo (formerly Sendinblue) API key
# Get it at: https://app.brevo.com → Account → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Brevo contact list ID to add discovered contacts to
# Get it at: https://app.brevo.com → Contacts → Lists → click your list → the ID is in the URL
BREVO_LIST_ID=12

# Set to "true" to print all actions without calling any APIs (safe to test)
DRY_RUN=false

# Maximum number of practices to process per run (default: 100)
MAX_PRACTICES=100
